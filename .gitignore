# Môi trường Python
.venv/
__pycache__/
*.egg-info/
.pytest_cache/

# Kết quả gán nhãn — dữ liệu riêng của từng người, KHÔNG đẩy lên repo chung.
# Dấu * là cố ý: bắt cả output/, output_12/, output_13_8/, output_17_8/...
# Đổi lại thành "output/" là lần sau đẩy nhầm cả đợt gán nhãn lên GitHub.
output*/
them/
scratch/

# Giao diện: nguồn được theo dõi, phần cài đặt và bản build thì không.
# Dựng lại bằng: cd ui && npm install && npm run build
ui/node_modules/
ui/dist/

# Rác cục bộ
.DS_Store
*.zip
.claude/scheduled_tasks.lock

# Hàng đợi lô. Chỉ là CHỈ MỤC — data.json trên đĩa mới là nguồn sự thật.
# Xoá lúc nào cũng được, `vsf batch reindex` dựng lại toàn bộ.
state/
